# Copy this file to .env.local and paste your key from https://platform.claude.com/settings/keys
# .env.local is gitignored, and the key is only read by the dev server (never sent to the browser).
ANTHROPIC_API_KEY=

# Optional Java Watchtower base URL, including /api/watchtower.
# Without it, search/routes/weather/places use public prototype providers.
# VITE_* values are public. Never put server API secrets here.
VITE_WATCHTOWER_API_URL=

# Optional raster tile provider. Set URL and attribution together.
# Defaults to attributed OpenStreetMap standard tiles for this prototype.
VITE_WATCHTOWER_TILE_URL=
VITE_WATCHTOWER_TILE_ATTRIBUTION=
